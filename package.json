    "test:auth": "playwright test --config playwright.auth.config.mjs",
    "test:database": "node scripts/test-database.mjs",
    "verify:published": "node scripts/verify-published-release.mjs",
    "android:assets": "node scripts/build-mobile-assets.mjs",
    "android:sync": "npm run android:assets && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release:unsigned": "npm run android:sync && cd android && ./gradlew assembleRelease bundleRelease",
    "test:tables": "node --test tests/tableLab.test.mjs",
    "test:tables:browser": "node tests/tableLab.browser.mjs && node tests/tableLab.unity.browser.mjs",
    "unity:install": "node scripts/install-unity-practice-build.mjs"
