[Unit]
Description=Imperial Games private KYC advisory comparison and retention
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/Projects/imperial-kyc-lab/.venv/bin/python %h/Projects/imperial-games-kyc-integration-20261022/services/kyc-worker/worker.py --config %h/.config/imperial-kyc/worker-20261022.json --models %h/Projects/imperial-kyc-lab/models --once
WorkingDirectory=%h/Projects/imperial-games-kyc-integration-20261022
UMask=0077
NoNewPrivileges=yes
LimitCORE=0
MemoryMax=768M
MemorySwapMax=0
TimeoutStartSec=240
Environment=OPENCV_LOG_LEVEL=ERROR
